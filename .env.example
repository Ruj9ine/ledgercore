# Copy to .env and set real values. Never commit .env.
POSTGRES_DB=ledgercore
POSTGRES_USER=ledgercore
POSTGRES_PASSWORD=change-me

DB_URL=jdbc:postgresql://localhost:5434/ledgercore
DB_USERNAME=ledgercore
DB_PASSWORD=change-me
SERVER_PORT=8080

# Required, at least 32 characters. Generate one (PowerShell):
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRATION_MINUTES=60

# Optional: creates the first admin account at startup if no user has this email yet.
# Use a strong password of at least 12 characters. An existing user is never promoted by this setting,
# and changing the password here later does not change an account that already exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=